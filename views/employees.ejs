<!DOCTYPE html>
<html>
<head>
<title>Employee List</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family: Arial, Helvetica, sans-serif;
}

body{
background: linear-gradient(135deg,#667eea,#764ba2);
padding:40px;
min-height:100vh;
}

h2{
text-align:center;
color:white;
margin-bottom:25px;
}

table{
width:85%;
margin:auto;
border-collapse:collapse;
background:white;
border-radius:10px;
overflow:hidden;
box-shadow:0 10px 25px rgba(0,0,0,0.2);
}

th,td{
padding:14px;
border-bottom:1px solid #eee;
text-align:center;
}

th{
background:#2c3e50;
color:white;
}

tr:hover{
background:#f5f7fa;
}

.action-btn{
padding:6px 12px;
border-radius:4px;
font-size:14px;
text-decoration:none;
color:white;
margin:2px;
display:inline-block;
}

.edit-btn{
background:#28a745;
}

.delete-btn{
background:#dc3545;
}

.action-btn:hover{
opacity:0.85;
}

.add-btn{
display:block;
width:220px;
margin:30px auto;
padding:12px;
text-align:center;
background:linear-gradient(to right,#00c6ff,#0072ff);
color:white;
text-decoration:none;
border-radius:8px;
font-weight:bold;
box-shadow:0 5px 15px rgba(0,0,0,0.2);
transition:0.3s;
}

.add-btn:hover{
transform:scale(1.05);
}

</style>

</head>

<body>

<h2>Employee List</h2>

<table>

<thead>
<tr>
<th>Name</th>
<th>Email</th>
<th>Role</th>
<th>Eligible</th>
<th>Actions</th>
</tr>
</thead>

<tbody>

<% if (employees.length > 0) { %>

<% employees.forEach(emp => { %>

<tr>
<td><%= emp.empName %></td>
<td><%= emp.empEmail %></td>
<td><%= emp.empRole %></td>
<td><%= emp.isEligible ? "Yes" : "No" %></td>

<td>
  <a href="/edit/<%= emp._id %>" class="action-btn edit-btn">Edit</a>
  <a href="/delete/<%= emp._id %>" class="action-btn delete-btn">Delete</a>
</td>

</tr>

<% }) %>

<% } else { %>

<tr>
<td colspan="5">No employees found</td>
</tr>

<% } %>

</tbody>

</table>

<a href="/" class="add-btn">Add New Employee</a>

</body>
</html>