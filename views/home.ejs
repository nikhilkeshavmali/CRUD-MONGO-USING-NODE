<!DOCTYPE html>
<html>
<head>
<title>Employee List</title>

<style>

/* ===============================
   GLOBAL RESET
   Removes default browser margin/padding
================================ */
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family: Arial, Helvetica, sans-serif;
}

/* ===============================
   PAGE BACKGROUND
================================ */
body{
background: linear-gradient(135deg,#667eea,#764ba2);
padding:40px;
min-height:100vh;
}

/* ===============================
   PAGE TITLE
================================ */
h2{
text-align:center;
color:white;
margin-bottom:25px;
}

/* ===============================
   TABLE DESIGN
================================ */
table{
width:85%;
margin:auto;
border-collapse:collapse;
background:white;
border-radius:10px;
overflow:hidden;
box-shadow:0 10px 25px rgba(0,0,0,0.2);
}

/* Table cells styling */
th,td{
padding:14px;
border-bottom:1px solid #eee;
text-align:center;
}

/* Table header styling */
th{
background:#2c3e50;
color:white;
}

/* Hover effect on rows */
tr:hover{
background:#f5f7fa;
}

/* ===============================
   ACTION BUTTON BASE STYLE
================================ */
.action-btn{
padding:6px 12px;
border-radius:4px;
font-size:14px;
text-decoration:none;
color:white;
margin:2px;
display:inline-block;
}

/* Edit button styling */
.edit-btn{
background:#28a745;
}

/* Delete button styling */
.delete-btn{
background:#dc3545;
}

/* Button hover effect */
.action-btn:hover{
opacity:0.85;
}

/* ===============================
   ADD NEW EMPLOYEE BUTTON
================================ */
.add-btn{
display:block;
width:220px;
margin:30px auto;
padding:12px;
text-align:center;
background:linear-gradient(to right,#00c6ff,#0072ff);
color:white;
text-decoration:none;
border-radius:8px;
font-weight:bold;
box-shadow:0 5px 15px rgba(0,0,0,0.2);
transition:0.3s;
}

/* Hover animation */
.add-btn:hover{
transform:scale(1.05);
}

</style>

</head>

<body>

<h2>Employee List</h2>

<table>

<thead>
<tr>
<th>Name</th>
<th>Email</th>
<th>Role</th>
<th>Eligible</th>
<th>Actions</th>
</tr>
</thead>

<tbody>

<!-- =====================================================
CHECK IF EMPLOYEE DATA EXISTS

employees variable comes from the backend:

app.get("/employees", async (req,res)=>{
   const employees = await empModel.find();
   res.render("employees",{employees});
})

If employees array has records → display them
If empty → show "No employees found"
===================================================== -->

<% if (employees.length > 0) { %>

<!-- =====================================================
LOOP THROUGH EACH EMPLOYEE OBJECT

forEach loop dynamically creates rows
for every employee stored in MongoDB
===================================================== -->

<% employees.forEach(emp => { %>

<tr>

<!-- Display employee name -->
<td><%= emp.empName %></td>

<!-- Display employee email -->
<td><%= emp.empEmail %></td>

<!-- Display employee role -->
<td><%= emp.empRole %></td>

<!-- =====================================================
BOOLEAN CHECK

If isEligible = true → show "Yes"
If isEligible = false → show "No"
===================================================== -->

<td><%= emp.isEligible ? "Yes" : "No" %></td>

<td>

<!-- =====================================================
EDIT BUTTON

When clicked → opens edit page

Route in backend:
GET /edit/:id

Example URL:
http://localhost:3000/edit/685abc123
===================================================== -->

<a href="/edit/<%= emp._id %>" class="action-btn edit-btn">Edit</a>

<!-- =====================================================
DELETE BUTTON

When clicked → deletes employee

Route in backend:
GET /delete/:id

Example URL:
http://localhost:3000/delete/685abc123
===================================================== -->

<a href="/delete/<%= emp._id %>" class="action-btn delete-btn">Delete</a>

</td>

</tr>

<% }) %>

<!-- =====================================================
IF DATABASE HAS NO EMPLOYEES
===================================================== -->

<% } else { %>

<tr>
<td colspan="5">No employees found</td>
</tr>

<% } %>

</tbody>

</table>
